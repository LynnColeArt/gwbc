10 PRINT "MONTH LENGTH LOOKUP"
20 DIM M$(11),D%(11)
30 RESTORE 200
40 FOR I%=0 TO 11
50 READ M$(I%),D%(I%)
60 NEXT I%
70 INPUT "MONTH (1-12)"; M%
80 IF M% < 1 OR M% > 12 THEN 150
90 LET I%=M%-1
100 PRINT M$(I%);" DAYS:";D%(I%)
110 RESTORE
120 READ Y$
130 PRINT "CALENDAR: ";Y$
140 GOTO 160
150 PRINT "MONTH OUT OF RANGE"
160 SYSTEM
190 DATA COMMON YEAR
200 DATA JANUARY,31,FEBRUARY,28,MARCH,31,APRIL,30
210 DATA MAY,31,JUNE,30,JULY,31,AUGUST,31
220 DATA SEPTEMBER,30,OCTOBER,31,NOVEMBER,30,DECEMBER,31
