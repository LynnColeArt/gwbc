10 PRINT "GREATEST COMMON DIVISOR"
20 INPUT "FIRST VALUE"; A%
30 INPUT "SECOND VALUE"; B%
40 IF A% < 0 THEN 90
50 IF B% < 0 THEN 90
60 GOSUB 200
70 PRINT "COMMON DIVISOR:"; A%
80 GOTO 400
90 PRINT "ENTER NONNEGATIVE VALUES"
100 GOTO 400
200 IF B% = 0 THEN 250
210 GOSUB 300
220 LET A% = B%
230 LET B% = R%
240 GOTO 200
250 RETURN
300 LET R% = A% MOD B%
310 RETURN
400 SYSTEM
